{
  "name": "progress-tracker",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "env": "node scripts/sync-env.mjs",
    "predev": "npm run env",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w web\"",
    "prebuild": "npm run env",
    "build": "npm run build -w api && npm run build -w web",
    "predb:migrate": "npm run env",
    "db:migrate": "npm run db:migrate -w api",
    "predb:seed": "npm run env",
    "db:seed": "npm run db:seed -w api",
    "predb:studio": "npm run env",
    "db:studio": "npm run db:studio -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "test": "npm run test -w api"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "sharp@0.34.5": true
  }
}
